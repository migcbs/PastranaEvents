# Desarrollo local (SQLite, no requiere configuración):
DATABASE_URL="file:./dev.db"

# Producción con Neon (Postgres) desde Vercel:
# 1. Crea el proyecto en https://neon.tech (o la integración de Neon en Vercel).
# 2. Copia la cadena de conexión y pégala aquí:
# DATABASE_URL="postgresql://usuario:password@ep-xxxx.neon.tech/jpastrana?sslmode=require"
# 3. En prisma/schema.prisma cambia provider = "sqlite" por provider = "postgresql"
# 4. Corre: npx prisma migrate dev --name init

PORT=4000

# Credenciales usadas SOLO por `npm run seed` para crear el usuario admin.
# Sin estas variables, el seed genera una contraseña aleatoria y la imprime
# una sola vez en la terminal.
# ADMIN_SEED_USERNAME="admin"
# ADMIN_SEED_PASSWORD="cambia-esto-por-algo-fuerte"

# Notificación por correo cuando llega una nueva reserva (Resend — resend.com).
# RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# ADMIN_NOTIFICATION_EMAIL="tu-correo@ejemplo.com"
# RESEND_FROM_EMAIL="Pastrana Events <onboarding@resend.dev>"
